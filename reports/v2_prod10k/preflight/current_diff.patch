+        "below_g5_count": int((lp < G5_LUMA_MIN).sum()) if lp.size else None,
+        "note": "final = vignette/noise/JPEG 적용 후, 학습이 실제로 보는 픽셀",
+    }
+
+    # ---- (b)(c) 팔레트 실치수 비율 ----------------------------------------
+    # label 의 `cuboid` 는 **world-frame Z-up AABB** 라 회전에 따라 변한다 — 치수로
