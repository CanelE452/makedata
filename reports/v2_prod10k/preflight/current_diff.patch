+    """종 모양이므로 ±1 sigma 안이 과반이어야 한다."""
+    rng = _random.Random(11)
+    vals = [SP2.sample_pallet_scale_ratio(rng) for _ in range(4000)]
+    near = sum(1 for v in vals
