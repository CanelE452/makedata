+    }
+
+    def _stat(vals):
+        if not vals:
+            return None
+        a = np.asarray(vals, dtype=float)
+        return {"min": float(a.min()), "median": float(np.median(a)),
+                "max": float(a.max())}
+
+    panels["panel_b_pallet_dimensions"] = {
