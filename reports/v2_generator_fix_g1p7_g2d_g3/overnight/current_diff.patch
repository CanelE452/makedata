+def fine_refinement_offsets(coarse_u_step, coarse_v_step, coarse_depth_step,
+                            scale=FINE_STEP_SCALE):
+    """coarse step 의 ±scale 배로 만든 축별 이웃 — 전체 grid 를 만들지 않는다.
